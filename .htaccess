# Apache config for foresightsolutions.io on GoDaddy shared hosting.
# Upload this file to public_html with the HTML. No build step.
# Rewrite and header directives are skipped when the module is unavailable.

# Served at the visitor's URL, so 404.html uses root-relative links.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www (http or https) -> https apex, in one hop.
  RewriteCond %{HTTP_HOST} ^www\.foresightsolutions\.io$ [NC]
  RewriteRule ^ https://foresightsolutions.io%{REQUEST_URI} [L,R=301]

  # http apex -> https apex.
  # Skip when a proxy already terminated TLS and set X-Forwarded-Proto, so
  # GoDaddy's front end cannot cause a redirect loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://foresightsolutions.io%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf HTTPS "^on$" HSTS_ELIGIBLE
  SetEnvIf X-Forwarded-Proto "^https$" HSTS_ELIGIBLE
</IfModule>

<IfModule mod_headers.c>
  # HSTS only when this response is actually HTTPS. Browsers ignore it on HTTP.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HSTS_ELIGIBLE
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Static site. form-action allows the Formspree diagnostic post.
  # script-src allows GoDaddy's injected tccl.min.js from img1.wsimg.com.
  # connect-src allows that script's beacon to csp.secureserver.net.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self' https://img1.wsimg.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://csp.secureserver.net; upgrade-insecure-requests"

  <FilesMatch "\.(css|ico|png|jpe?g|gif|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
